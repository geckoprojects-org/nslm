# ServiceLoader mediator WITHOUT OSGi Service Loader Mediator metadata for any launcher: a framework
# extension bundle whose ExtensionBundle-Activator registers a WeavingHook. The hook rewrites every
# ServiceLoader.load(Class) / load(Class, ClassLoader) call site in bundle classes to
# org.example.spi.weaver.ServiceLoaders.load(..., CallingClass.class), which returns a real
# java.util.ServiceLoader backed by SpiRegistry/SpiClassLoader of org.example.spi.core (private copy,
# shared with org.example.spi.mediator). See README.md at the repository root.
Bundle-Description: java.util.ServiceLoader across bundles without metadata: WeavingHook \
	(java.lang.classfile) that redirects ServiceLoader.load call sites to ServiceLoaders.load, \
	backed by the META-INF/services registry of org.example.spi.core.

# Framework extension: lives in the framework class loader, is resolved at install time and its
# activator runs before any regular bundle starts, so no start level ordering is needed. Its
# exports become exports of the system bundle; woven classes get a DynamicImport-Package on it.
Fragment-Host: system.bundle; extension:=framework
ExtensionBundle-Activator: org.example.spi.weaver.SpiWeaver

Export-Package: org.example.spi.weaver;version=1.0.0

# Bundles that DO carry OSGi Service Loader Mediator metadata (slf4j-api 2 and its providers are the
# common case) do not resolve at all unless someone provides the extender capability. A framework
# extension's capabilities become capabilities of the system bundle - Felix 7.0.5 and Equinox 3.23 both
# do that, WeaverTest checks it - so at runtime the weaver announces them itself and nothing else is
# needed. The processor is what this bundle really is; the registrar clause is satisfied structurally
# only: providers become visible to java.util.ServiceLoader, they are not registered as OSGi services.
# For the bnd resolver this bundle is an ordinary resource providing osgi.extender, which is why the
# bndruns declare the same two capabilities in -runsystemcapabilities: otherwise the resolver would
# drag the weaver into runs that use one of the other two mediator deployments.
Provide-Capability: \
	osgi.extender;osgi.extender=osgi.serviceloader.processor;version:Version=1.0.0,\
	osgi.extender;osgi.extender=osgi.serviceloader.registrar;version:Version=1.0.0

# own package plus the private copy of the shared core
-privatepackage: \
	org.example.spi.weaver,\
	org.example.spi.core

# an extension bundle can only import from the system bundle
Import-Package: \
	org.osgi.framework.*,\
	org.osgi.util.tracker,\
	!*

-jpms-module-info: ,
-sources: false
-noextraheaders: true
