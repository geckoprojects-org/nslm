-tester: biz.aQute.tester.junit-platform

-runfw: org.eclipse.osgi;version='[3.23,3.24)'
-runee: JavaSE-25

# slf4j-api 2 and its providers are the common case of bundles that DO carry OSGi Service Loader
# Mediator metadata: slf4j.api requires osgi.extender=osgi.serviceloader.processor plus
# osgi.serviceloader=org.slf4j.spi.SLF4JServiceProvider, slf4j.simple requires
# osgi.extender=osgi.serviceloader.registrar. Without a provider of those extender capabilities OSGi
# does not resolve them at all, so the launch configuration declares them on the system bundle. The
# weaver carries the same two capabilities in its own manifest and they really do end up on the system
# bundle at runtime (WeaverTest checks that on Felix and Equinox), but the bnd resolver treats the
# framework extension as an ordinary resource: left to itself it would pull org.example.spi.weaver into
# the runs that use another mediator. The osgi.serviceloader capability itself comes from the provider
# bundle, as the spec intends.
-runsystemcapabilities: \
	osgi.extender;osgi.extender=osgi.serviceloader.processor;version:Version=1.0.0,\
	osgi.extender;osgi.extender=osgi.serviceloader.registrar;version:Version=1.0.0

# Weaving mediator: standard bnd launcher, NO -runpath additions. org.example.spi.weaver is a
# framework extension bundle (ExtensionBundle-Activator + WeavingHook, java.lang.classfile) that
# redirects every ServiceLoader.load call site to ServiceLoaders.load.
# spi.weaver.tccl: also serve the ServiceLoader calls inside the JDK (StAX test) through the TCCL
-runproperties: \
	spi.weaver.trace=true,\
	spi.weaver.tccl=true,\
	spi.weaver.serviceLoaderOnly=false

# Bundles without ServiceLoader metadata are invisible to the resolver, so every one is listed.
#  * Greeter 1.0: provider + consumer; Greeter 2.0 (same package, other bundle): provider + consumer.
#    Class space test: each consumer must only see providers of its own API version.
#  * JAXB: jakarta.xml.bind-api + GlassFish runtime as they come from Maven Central.
#  * WebSocket: jakarta.websocket-client-api + Tyrus grizzly client (module-info provides only).
#  * JSON-P / JSON-B: jakarta.json-api + Parsson, jakarta.json.bind-api + Yasson (Yasson's provider itself
#    looks up the JSON-P provider through ServiceLoader: a two level chain).
#  * StAX: Woodstox, looked up by the JDK's own javax.xml.stream.FactoryFinder through the TCCL.
#  * REST 4.0 (Jersey 4 common) and Persistence 3.1 (EclipseLink 4): ServiceLoader.load(type, TCCL) in the APIs.
#  * Mail 2.1 (Angus Mail) and Bean Validation 3.0 (Hibernate Validator): ServiceLoader.load(type, TCCL) in the APIs.
# The JUnit platform launcher and engine are needed by biz.aQute.tester.junit-platform (-tester).
-runrequires: \
	bnd.identity;id='junit-platform-launcher',\
	bnd.identity;id='junit-jupiter-engine',\
	bnd.identity;id='org.example.serviceloader.tests',\
	bnd.identity;id='org.example.serviceloader.provider',\
	bnd.identity;id='org.example.serviceloader.consumer',\
	bnd.identity;id='org.example.serviceloader.provider.v2',\
	bnd.identity;id='org.example.serviceloader.consumer.v2',\
	bnd.identity;id='org.example.serviceloader.consumer.rb',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.glassfish.jaxb.runtime',\
	bnd.identity;id='jakarta.websocket-api',\
	bnd.identity;id='org.glassfish.tyrus.container-grizzly-client',\
	bnd.identity;id='org.eclipse.parsson',\
	bnd.identity;id='yasson',\
	bnd.identity;id='com.fasterxml.woodstox.woodstox-core',\
	bnd.identity;id='org.glassfish.jersey.core.jersey-common',\
	bnd.identity;id='org.eclipse.persistence.jpa',\
	bnd.identity;id='org.eclipse.angus.mail',\
	bnd.identity;id='org.hibernate.validator',\
	bnd.identity;id='org.example.spi.weaver'

-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	com.sun.xml.bind.jaxb-osgi;version='[4.0.2,4.0.3)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.websocket-api;version='[2.2.0,2.2.1)',\
