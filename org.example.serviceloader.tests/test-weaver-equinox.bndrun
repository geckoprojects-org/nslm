	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.persistence-api;version='[3.1.0,3.1.1)',\
	jakarta.ws.rs-api;version='[4.0.0,4.0.1)',\
	org.eclipse.persistence.core;version='[4.0.9,4.0.10)',\
	org.eclipse.persistence.jpa;version='[4.0.9,4.0.10)',\
	org.glassfish.hk2.osgi-resource-locator;version='[3.0.0,3.0.1)',\
	org.glassfish.jersey.core.jersey-common;version='[4.0.2,4.0.3)',\
	com.fasterxml.classmate;version='[1.7.0,1.7.1)',\
	jakarta.mail-api;version='[2.1.3,2.1.4)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
