	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.example.serviceloader.api;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.api.v2;version='[2.0.0,2.0.1)',\
	org.example.serviceloader.consumer;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.consumer.v2;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.provider;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.provider.v2;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.tests;version='[1.0.0,1.0.1)',\
	org.example.spi.weaver;version='[1.0.0,1.0.1)',\
	org.glassfish.grizzly.framework;version='[4.0.2,4.0.3)',\
	org.glassfish.grizzly.http;version='[4.0.2,4.0.3)',\
	org.glassfish.jaxb.runtime;version='[4.0.5,4.0.6)',\
	org.glassfish.tyrus.client;version='[2.2.0,2.2.1)',\
	org.glassfish.tyrus.container-grizzly-client;version='[2.2.0,2.2.1)',\
	org.glassfish.tyrus.core;version='[2.2.0,2.2.1)',\
	org.glassfish.tyrus.spi;version='[2.2.0,2.2.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
