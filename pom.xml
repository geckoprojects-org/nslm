<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example.spi</groupId>
  <artifactId>nslm</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>ServiceLoader in OSGi without mediator metadata</name>
  <description>Two mediators that make plain java.util.ServiceLoader work across OSGi bundles that carry
    no OSGi Service Loader Mediator metadata: a weaving framework extension and a launcher based
    class loader variant. Plus example bundles and OSGi integration tests on Felix and Equinox.</description>

  <modules>
    <module>org.example.spi.core</module>
    <module>org.example.spi.weaver</module>
    <module>org.example.spi.launcher</module>
    <module>org.example.spi.mediator</module>
    <module>org.example.spi.equinox</module>
    <module>examples</module>
    <module>org.example.serviceloader.tests</module>
    <module>org.example.serviceloader.bench</module>
  </modules>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <bnd.version>7.4.0</bnd.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
    <maven.dependency.plugin.version>3.8.1</maven.dependency.plugin.version>
    <maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
    <flatten.plugin.version>1.7.0</flatten.plugin.version>

    <osgi.core.version>8.0.0</osgi.core.version>
    <osgi.annotation.version>8.1.0</osgi.annotation.version>
    <osgi.ds.annotations.version>1.5.1</osgi.ds.annotations.version>
    <felix.framework.version>7.0.5</felix.framework.version>
    <equinox.version>3.23.0</equinox.version>
    <felix.scr.version>2.2.12</felix.scr.version>

    <junit.version>5.14.2</junit.version>
    <junit.platform.version>1.14.2</junit.platform.version>
    <osgi.test.version>1.3.0</osgi.test.version>
    <assertj.version>3.27.7</assertj.version>
    <bytebuddy.version>1.18.4</bytebuddy.version>
    <spifly.version>1.3.7</spifly.version>
    <asm.version>9.10.1</asm.version>
    <woodstox.version>7.1.1</woodstox.version>
    <stax2.version>4.2.2</stax2.version>
    <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>
    <jersey.version>4.0.2</jersey.version>
    <jakarta.persistence.version>3.1.0</jakarta.persistence.version>
    <eclipselink.version>4.0.9</eclipselink.version>
    <eclipselink.asm.version>9.7.1</eclipselink.asm.version>
    <jakarta.mail.version>2.1.3</jakarta.mail.version>
    <angus.mail.version>2.0.3</angus.mail.version>
    <jakarta.validation.version>3.0.2</jakarta.validation.version>
    <hibernate.validator.version>8.0.2.Final</hibernate.validator.version>
    <jboss.logging.version>3.5.3.Final</jboss.logging.version>
    <classmate.version>1.7.0</classmate.version>
    <jakarta.el.version>5.0.1</jakarta.el.version>
    <expressly.version>5.0.0</expressly.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>osgi.core</artifactId>
        <version>${osgi.core.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>osgi.annotation</artifactId>
        <version>${osgi.annotation.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.component.annotations</artifactId>
        <version>${osgi.ds.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.framework</artifactId>
        <version>${felix.framework.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.platform</groupId>
        <artifactId>org.eclipse.osgi</artifactId>
        <version>${equinox.version}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.spi.core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.spi.launcher</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.spi.mediator</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.spi.weaver</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.spi.equinox</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.api</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.api.v2</artifactId>
        <version>2.0.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.provider</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.provider.v2</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.consumer</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.consumer.v2</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.example.spi</groupId>
        <artifactId>org.example.serviceloader.consumer.rb</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- ${revision} (CI friendly version): install/deploy poms with the resolved version -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten.plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
          <configuration>
            <archive>
              <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
            </archive>
            <skipIfEmpty>true</skipIfEmpty>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven.dependency.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <!-- every jar module carries a bnd.bnd next to its pom; bnd-process writes the manifest -->
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-maven-plugin</artifactId>
          <version>${bnd.version}</version>
          <executions>
            <execution>
              <id>bnd-process</id>
              <goals>
                <goal>bnd-process</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-resolver-maven-plugin</artifactId>
          <version>${bnd.version}</version>
        </plugin>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-testing-maven-plugin</artifactId>
          <version>${bnd.version}</version>
        </plugin>
        <plugin>
          <groupId>biz.aQute.bnd</groupId>
          <artifactId>bnd-run-maven-plugin</artifactId>
          <version>${bnd.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
