-tester: biz.aQute.tester.junit-platform
-runfw: org.eclipse.osgi;version='[3.23,3.24)'
-runee: JavaSE-25

# Apache Aries SPI Fly dynamic bundle with ASM 9.10.1 as separate bundles (needed for Java 25 class
# files). The example bundles carry no metadata, so SPI Fly is told by its auto properties which
# bundles to weave (consumers) and which META-INF/services to publish (providers). Both provider
# bundles are installed, Greeter 1.0 and Greeter 2.0: SPI Fly has no notion of class spaces, the probes
# show what happens to the 1.0 consumer. The benchmark aborts itself in this run.
-runproperties: \
	bench.iterations=1000,\
	bench.warmup=100,\
	org.apache.aries.spifly.auto.consumers=org.example.serviceloader.bench,\
	org.apache.aries.spifly.auto.providers=org.example.serviceloader.provider

-runrequires: \
	bnd.identity;id='junit-platform-launcher',\
	bnd.identity;id='junit-jupiter-engine',\
	bnd.identity;id='org.example.serviceloader.bench',\
	bnd.identity;id='org.example.serviceloader.provider',\
	bnd.identity;id='com.fasterxml.woodstox.woodstox-core',\
	bnd.identity;id='org.example.serviceloader.provider.v2',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle'

-runbundles: \
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-engine;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	junit-platform-engine;version='[1.14.2,1.14.3)',\
	junit-platform-launcher;version='[1.14.2,1.14.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.example.serviceloader.api;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.api.v2;version='[2.0.0,2.0.1)',\
	org.example.serviceloader.bench;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.provider;version='[1.0.0,1.0.1)',\
	org.example.serviceloader.provider.v2;version='[1.0.0,1.0.1)',\
	org.objectweb.asm;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.commons;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.tree;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.tree.analysis;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.util;version='[9.10.1,9.10.2)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	com.fasterxml.woodstox.woodstox-core;version='[7.1.1,7.1.2)',\
	stax2-api;version='[4.2.2,4.2.3)'
