<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.example.spi</groupId>
    <artifactId>nslm</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>org.example.serviceloader.bench</artifactId>
  <name>Benchmark and capability probes</name>
  <description>The same ServiceLoader loops run under the weaver, the launcher based mediator and Apache
    Aries SPI Fly (auto properties, dynamic bundle with external ASM), plus a plain classpath baseline
    (surefire). Probes record what each mediator handles: method references, lambdas, class spaces,
    stopped provider bundles.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.serviceloader.api</artifactId>
    </dependency>

    <!-- runtime: bndrun candidates -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.osgi</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>biz.aQute.bnd</groupId>
      <artifactId>biz.aQute.tester.junit-platform</artifactId>
      <version>${bnd.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>${junit.platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.spi.weaver</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.spi.launcher</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.spi.mediator</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.serviceloader.api.v2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.serviceloader.provider</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.example.spi</groupId>
      <artifactId>org.example.serviceloader.provider.v2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- StAX scenario: Woodstox as a plain bundle, found by the JDK's own FactoryFinder through the TCCL -->
    <dependency>
      <groupId>com.fasterxml.woodstox</groupId>
      <artifactId>woodstox-core</artifactId>
      <version>${woodstox.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.codehaus.woodstox</groupId>
      <artifactId>stax2-api</artifactId>
      <version>${stax2.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Apache Aries SPI Fly: dynamic bundle with ASM as separate bundles (the framework extension
         embeds an ASM that stops at Java 22 class files; ASM 9.8+ reads Java 25) -->
    <dependency>
      <groupId>org.apache.aries.spifly</groupId>
      <artifactId>org.apache.aries.spifly.dynamic.bundle</artifactId>
      <version>${spifly.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-commons</artifactId>
      <version>${asm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-util</artifactId>
      <version>${asm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>${asm.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-analysis</artifactId>
      <version>${asm.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <!-- plain classpath baseline, src/test/java -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <bench.iterations>200000</bench.iterations>
            <bench.warmup>50000</bench.warmup>
          </systemPropertyVariables>
          <!-- a flat class path has no class spaces: keep the Greeter 2.0 bundles out of the baseline -->
          <classpathDependencyExcludes>
            <classpathDependencyExclude>org.example.spi:org.example.serviceloader.api.v2</classpathDependencyExclude>
            <classpathDependencyExclude>org.example.spi:org.example.serviceloader.provider.v2</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-resolver-maven-plugin</artifactId>
        <configuration>
          <bndruns>
            <bndrun>bench-weaver.bndrun</bndrun>
            <bndrun>bench-mediator.bndrun</bndrun>
            <bndrun>bench-spifly.bndrun</bndrun>
            <bndrun>bench-spifly-classspace.bndrun</bndrun>
            <bndrun>bench-weaver-equinox.bndrun</bndrun>
            <bndrun>bench-mediator-equinox.bndrun</bndrun>
            <bndrun>bench-spifly-equinox.bndrun</bndrun>
            <bndrun>bench-spifly-classspace-equinox.bndrun</bndrun>
          </bndruns>
          <failOnChanges>false</failOnChanges>
          <writeOnChanges>true</writeOnChanges>
          <reportOptional>false</reportOptional>
        </configuration>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-testing-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>bench</id>
            <goals>
              <goal>testing</goal>
            </goals>
            <configuration>
              <bndruns>
                <bndrun>bench-weaver.bndrun</bndrun>
                <bndrun>bench-mediator.bndrun</bndrun>
                <bndrun>bench-spifly.bndrun</bndrun>
                <bndrun>bench-spifly-classspace.bndrun</bndrun>
                <bndrun>bench-weaver-equinox.bndrun</bndrun>
                <bndrun>bench-mediator-equinox.bndrun</bndrun>
                <bndrun>bench-spifly-equinox.bndrun</bndrun>
                <bndrun>bench-spifly-classspace-equinox.bndrun</bndrun>
              </bndruns>
              <failOnChanges>false</failOnChanges>
              <resolve>false</resolve>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
